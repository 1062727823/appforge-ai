# AppForge AI — 环境变量

# DeepSeek AI（必填）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro

# 代理配置（Docker 容器无法直连 Anthropic API 时使用）
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# NO_PROXY=localhost,127.0.0.1,api,agent-runner,code-server

# Agent Runner
AGENT_RUNNER_IMAGE=appforge/agent-runner:latest
AGENT_RUNNER_URL=http://agent-runner:8080
APPFORGE_DOCKER_VOLUME=appforge-data
RUNNER_CALLBACK_URL=http://api:4173
RUNNER_CALLBACK_TOKEN=dev-runner-token
DOCKER_NETWORK=appforge-net
AGENT_MEMORY_LIMIT=2g
AGENT_CPU_LIMIT=2
AGENT_RUNNER_TIMEOUT_MS=3600000
AGENT_POOL_MAX_CONCURRENT=3

# Code-Server Web IDE
CODE_SERVER_URL=http://code-server:8080
CODE_SERVER_WORKSPACE_ROOT=/data/appforge/workspaces

# GitLab（可选）
# GITLAB_BASE_URL=http://localhost:8929
# GITLAB_INTERNAL_URL=http://host.docker.internal:8929
# GITLAB_TOKEN=glpat-xxxxxxxx

# API
APPFORGE_DATA_DIR=./storage/appforge
APP_GATEWAY_PUBLIC_URL=http://127.0.0.1
APP_DEPLOY_GATEWAY_PUBLIC_URL=http://127.0.0.1
APPFORGE_ENV_FILE=/app/.env
PORT=4173
HOST=127.0.0.1
LOG_LEVEL=debug
